{
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "regions": ["iad1"],
  "redirects": [
    { "source": "/resume", "destination": "/resume.pdf", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/siemens/(.*)", "destination": "/siemens/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
